---
import LessonProgress from './LessonProgress';
import PreviousNextLesson from './PreviousNextLesson.astro';
import type { Lesson } from '@/types/lesson';
import type { PreviousNextNavigation } from '@/types/navigation';
import { ExternalLink, BookOpen } from 'lucide-react';

interface Props {
  lesson: Lesson;
  courseSlug: string;
  chapterSlug: string;
  navigation: PreviousNextNavigation;
}

const { lesson, courseSlug, chapterSlug, navigation } = Astro.props;
---

<footer class="mt-12">
  <!-- Interactive Lesson Completion -->
  <LessonProgress
    client:load
    courseSlug={courseSlug}
    chapterSlug={chapterSlug}
    lessonId={lesson.id}
  />

  <!-- Academic / RFC References -->
  {lesson.references && lesson.references.length > 0 && (
    <div class="my-8 pt-6 border-t border-border-subtle">
      <div class="flex items-center gap-1.5 font-mono text-xs font-semibold text-text-primary uppercase tracking-wider mb-3">
        <BookOpen className="w-3.5 h-3.5 text-brand" />
        <span>Canonical References & RFCs</span>
      </div>
      <ul class="space-y-2">
        {lesson.references.map((ref) => (
          <li>
            <a
              href={ref.url}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-brand hover:underline font-technical"
            >
              <span>{ref.title}</span>
              <ExternalLink className="w-3 h-3 text-text-muted" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Previous & Next Navigation -->
  <PreviousNextLesson navigation={navigation} />
</footer>
