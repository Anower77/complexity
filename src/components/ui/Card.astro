---
interface Props {
  as?: string;
  href?: string;
  class?: string;
  hover?: boolean;
}

const {
  as: Component = 'div',
  href,
  class: className = '',
  hover = false
} = Astro.props;

const baseClasses = 'bg-surface border border-border-subtle rounded-lg p-5 transition-all';
const hoverClasses = hover ? 'hover:border-border-strong hover:shadow-sm' : '';
const combined = `${baseClasses} ${hoverClasses} ${className}`;
---

{
  href ? (
    <a href={href} class={`block ${combined}`}>
      <slot />
    </a>
  ) : (
    <div class={combined}>
      <slot />
    </div>
  )
}
