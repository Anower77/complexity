---
import ThemeToggle from './ThemeToggle';
import { formatPath } from '@/lib/utilities/url';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { label: 'Explore', href: formatPath('/explore') },
  { label: 'Learning Paths', href: formatPath('/path') },
  { label: 'System Design', href: formatPath('/system-design') },
  { label: 'Articles', href: formatPath('/articles') },
  { label: 'About', href: formatPath('/about') }
];
---

<header class="sticky top-0 z-40 w-full border-b border-border-subtle bg-canvas/90 backdrop-blur-md">
  <div class="max-w-layout mx-auto flex h-14 items-center justify-between px-4 sm:px-6">
    <div class="flex items-center gap-8">
      <a href={formatPath('/')} class="flex items-baseline gap-2.5 group">
        <span class="font-bold text-lg tracking-tight font-technical text-text-primary group-hover:text-brand transition-colors">
          complexity<span class="text-brand">.</span>
        </span>
        <span class="hidden sm:inline-block font-mono text-[11px] text-text-muted px-2 py-0.5 rounded bg-surface-elevated border border-border-subtle">
          System Design
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-6">
        {navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href) && item.href !== formatPath('/');
          return (
            <a
              href={item.href}
              class={`text-xs font-medium transition-colors hover:text-text-primary font-technical ${
                isActive ? 'text-brand font-semibold' : 'text-text-secondary'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={formatPath('/search')}
        aria-label="Search articles and system design concepts"
        class="hidden sm:flex items-center gap-2 px-3 py-1.5 text-xs text-text-muted bg-surface-elevated border border-border-subtle rounded-md hover:border-border-strong transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Search system design...</span>
        <kbd class="font-mono text-[10px] bg-canvas px-1.5 py-0.5 rounded border border-border-subtle">⌘K</kbd>
      </a>

      <a
        href={formatPath('/search')}
        aria-label="Search"
        class="sm:hidden p-2 text-text-secondary hover:text-text-primary rounded-md"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <ThemeToggle client:load />

      <a
        href="https://github.com/Anower77/complexity"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub Repository"
        class="p-2 text-text-secondary hover:text-text-primary transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
      </a>

      <!-- Mobile Dropdown Toggle Button -->
      <button
        id="mobile-nav-toggle"
        type="button"
        class="lg:hidden p-2 text-text-secondary hover:text-text-primary rounded-md"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border-subtle bg-surface px-4 py-3 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-md text-xs font-medium text-text-secondary hover:text-text-primary hover:bg-surface-elevated font-technical"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
