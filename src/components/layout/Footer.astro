---
import { formatPath } from '@/lib/utilities/url';
---

<footer class="mt-auto border-t border-border-subtle bg-surface py-12 px-4 sm:px-6">
  <div class="max-w-layout mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="md:col-span-2 space-y-3">
      <div class="flex items-center gap-2">
        <span class="font-bold text-base tracking-tight font-technical text-text-primary">
          complexity<span class="text-brand">.</span>
        </span>
        <span class="font-mono text-[10px] text-text-muted px-1.5 py-0.5 rounded bg-surface-elevated border border-border-subtle">
          Open Engineering Publication
        </span>
      </div>
      <p class="text-xs text-text-secondary leading-relaxed max-w-sm">
        Backend system design, from first principles. Break software systems into components, understand how they scale, and simulate real-world failure modes.
      </p>
      <div class="text-[11px] text-text-muted font-mono pt-2">
        Free & Open Reference • 2026
      </div>
    </div>

    <div>
      <h3 class="font-technical text-xs font-semibold uppercase tracking-wider text-text-primary mb-3">Architecture</h3>
      <ul class="space-y-2 text-xs text-text-secondary">
        <li><a href={formatPath('/explore')} class="hover:text-text-primary transition-colors">Explore Topics</a></li>
        <li><a href={formatPath('/path')} class="hover:text-text-primary transition-colors">Structured Paths</a></li>
        <li><a href={formatPath('/system-design')} class="hover:text-text-primary transition-colors">System Design Blueprints</a></li>
        <li><a href={formatPath('/articles')} class="hover:text-text-primary transition-colors">Articles & Guides</a></li>
        <li><a href={formatPath('/search')} class="hover:text-text-primary transition-colors">Search Index</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-technical text-xs font-semibold uppercase tracking-wider text-text-primary mb-3">Platform</h3>
      <ul class="space-y-2 text-xs text-text-secondary">
        <li><a href={formatPath('/about')} class="hover:text-text-primary transition-colors">Editorial Manifesto</a></li>
        <li><a href="https://github.com/Anower77/complexity" target="_blank" rel="noreferrer" class="hover:text-text-primary transition-colors">Source Code</a></li>
        <li><a href="https://github.com/Anower77/complexity/issues" target="_blank" rel="noreferrer" class="hover:text-text-primary transition-colors">Suggest a Topic</a></li>
      </ul>
    </div>
  </div>
</footer>
