---
import { formatPath } from '@/lib/utilities/url';
---

<footer class="mt-auto border-t border-border-subtle bg-surface py-12 px-4 sm:px-6">
  <div class="max-w-layout mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="md:col-span-2 space-y-3">
      <div class="flex items-center gap-2">
        <span class="w-5 h-5 rounded bg-text-primary text-canvas flex items-center justify-center font-mono font-bold text-[10px]">
          CX
        </span>
        <span class="font-bold text-sm tracking-tight font-technical">Complexity</span>
      </div>
      <p class="text-xs text-text-muted leading-relaxed max-w-sm">
        Understand how systems work, why they break, and how engineers design them to scale. An interactive, course-oriented engineering education platform.
      </p>
      <div class="text-[11px] text-text-muted font-mono pt-2">
        Editorial Minimalist Platform • 2026
      </div>
    </div>

    <div>
      <h3 class="font-technical text-xs font-semibold uppercase tracking-wider text-text-primary mb-3">Learning</h3>
      <ul class="space-y-2 text-xs text-text-secondary">
        <li><a href={formatPath('/learn')} class="hover:text-text-primary transition-colors">Learning Paths</a></li>
        <li><a href={formatPath('/courses')} class="hover:text-text-primary transition-colors">Course Directory</a></li>
        <li><a href={formatPath('/search')} class="hover:text-text-primary transition-colors">Search Lessons</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-technical text-xs font-semibold uppercase tracking-wider text-text-primary mb-3">Platform</h3>
      <ul class="space-y-2 text-xs text-text-secondary">
        <li><a href={formatPath('/about')} class="hover:text-text-primary transition-colors">Editorial Philosophy</a></li>
        <li><a href="https://github.com/Anower77/complexity" target="_blank" rel="noreferrer" class="hover:text-text-primary transition-colors">Source Code</a></li>
        <li><a href="https://github.com/Anower77/complexity/issues" target="_blank" rel="noreferrer" class="hover:text-text-primary transition-colors">Report an Issue</a></li>
      </ul>
    </div>
  </div>
</footer>
