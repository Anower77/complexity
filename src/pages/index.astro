---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SystemFlowSimulator from '@/components/visualization/SystemFlowSimulator';
import InteractiveKnowledgeMap from '@/components/visualization/InteractiveKnowledgeMap';
import CurriculumFlowGraph from '@/components/visualization/CurriculumFlowGraph';
import WorkflowDiagram from '@/components/visualization/WorkflowDiagram';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { TOPICS, CATEGORIES } from '@/data/topics';
import { formatPath } from '@/lib/utilities/url';
import {
  ArrowRight,
  Clock,
  Sparkles,
  Layers,
  Cpu,
  Network,
  Database,
  ShieldCheck,
  Zap,
  Terminal,
  Server
} from 'lucide-react';

const featuredArticles = [
  {
    number: '01.01',
    title: 'Introduction to Client-Server Architecture',
    description: 'Deconstructing the foundational communication paradigm of distributed software. Socket allocations, state invariants, and physical network boundaries.',
    readingTime: '7 min',
    interactiveType: 'Interactive Simulator',
    status: 'published',
    url: formatPath('/articles/client-server-architecture')
  },
  {
    number: '01.02',
    title: 'Request Lifecycle & Transport Protocols',
    description: 'Tracing a network packet from socket allocation down through TCP handshake, TLS 1.3 negotiation, and HTTP/2 stream multiplexing.',
    readingTime: '9 min',
    interactiveType: 'Live Workflow Diagram',
    status: 'published',
    url: formatPath('/articles/request-lifecycle-and-protocols')
  },
  {
    number: '02.04',
    title: 'Kubernetes Services: ClusterIP vs NodePort vs LoadBalancer',
    description: 'Routing ingress traffic to ephemeral pods across cluster nodes. Interactive packet routing stepper and production YAML specifications.',
    readingTime: '14 min',
    interactiveType: 'Traffic Simulator & Stepper',
    status: 'published',
    url: formatPath('/articles/kubernetes-services-clusterip-nodeport-loadbalancer')
  }
];

const featuredTopics = [
  {
    title: 'Linux Epoll & File Descriptors',
    domain: 'Linux & OS Runtime',
    difficulty: 'Intermediate',
    desc: 'Why select() and poll() scale with O(N) complexity and how the Linux kernel solved the C10K concurrency bottleneck with epoll event readiness.',
    prereq: 'Client-Server Architecture',
    slug: 'linux-epoll'
  },
  {
    title: 'Redis: In-Memory Caching & Eviction',
    domain: 'Storage & Caching',
    difficulty: 'Intermediate',
    desc: 'Single-threaded event loops, LRU/LFU memory eviction algorithms, and thundering herd mitigation under extreme traffic surges.',
    prereq: 'Reverse Proxies',
    slug: 'redis-caching'
  },
  {
    title: 'Kafka: Distributed Commit Logs',
    domain: 'Distributed Systems',
    difficulty: 'Advanced',
    desc: 'Zero-copy sequential disk I/O, OS page cache exploitation, consumer group rebalancing, and partition leader election.',
    prereq: 'Asynchronous Queues',
    slug: 'kafka-commit-log'
  },
  {
    title: 'Rate Limiting Algorithms',
    domain: 'Production & Reliability',
    difficulty: 'Advanced',
    desc: 'Mathematical comparison of Token Bucket, Leaky Bucket, and Sliding Window Log algorithms for high-throughput API gateway protection.',
    prereq: 'Redis Caching',
    slug: 'rate-limiting'
  },
  {
    title: 'Circuit Breakers & Cascading Outages',
    domain: 'Production & Reliability',
    difficulty: 'Advanced',
    desc: 'Preventing catastrophic retry storms when downstream microservices degrade, with automated three-state failure detection.',
    prereq: 'Async Message Queues',
    slug: 'circuit-breakers'
  },
  {
    title: 'Docker Internals: Namespaces & Cgroups',
    domain: 'Linux & OS Runtime',
    difficulty: 'Intermediate',
    desc: 'How container engines create the illusion of isolated operating systems using Linux PID/mount namespaces, cgroups, and layered file systems.',
    prereq: 'Linux Epoll',
    slug: 'container-runtimes'
  }
];

const caseStudiesPreview = [
  {
    title: 'High-Throughput URL Shortener',
    difficulty: 'Intermediate',
    scale: '100,000 QPS (Read-Heavy)',
    desc: 'Base62 encoding, distributed counter ranges, multi-tier Redis caching, and B-Tree index guarantees.'
  },
  {
    title: 'Real-Time Chat & Direct Messaging',
    difficulty: 'Advanced',
    scale: '500,000 Concurrent Sockets',
    desc: 'Stateful WebSocket connection gateways, Redis Pub/Sub multiplexers, presence heartbeats, and Cassandra archives.'
  },
  {
    title: 'Adaptive Bitrate Video Streaming',
    difficulty: 'Advanced',
    scale: '2,000,000 Concurrent Streams',
    desc: 'Chunked HLS media segmentation, distributed transcoding DAGs, multi-tier edge CDN caching, and origin shield protection.'
  }
];
---

<BaseLayout
  title="Complexity — Open Engineering Publication & System Architecture Reference"
  description="Understand the systems behind modern software. Deconstruct backend infrastructure, network lifecycles, and distributed architecture through interactive flow diagrams and first-principles guides."
>
  <!-- Section 2 — Hero -->
  <section class="border-b border-border-subtle bg-surface/40 pt-16 pb-20 px-4 sm:px-6 relative overflow-hidden">
    <div class="max-w-layout mx-auto">
      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-subtle border border-brand-border text-brand text-xs font-mono mb-6">
          <span class="w-2 h-2 rounded-full bg-brand animate-ping"></span>
          <span>OPEN ENGINEERING PUBLICATION & SYSTEM DESIGN REFERENCE</span>
        </div>

        <h1 class="font-editorial text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-text-primary leading-[1.08] mb-6">
          Understand the systems behind <span class="italic text-brand">modern software</span>.
        </h1>

        <p class="font-technical text-lg sm:text-xl text-text-secondary leading-relaxed mb-8 max-w-2xl">
          Explore the engineering concepts, infrastructure, and architecture patterns that power real-world applications. Learn how components connect, how systems scale, and why engineering decisions matter.
        </p>

        <div class="flex items-center flex-wrap gap-4">
          <Button href={formatPath('/explore')} variant="primary" size="lg">
            <span>Explore Engineering Topics</span>
            <ArrowRight class="w-4 h-4" />
          </Button>

          <Button href={formatPath('/path')} variant="secondary" size="lg">
            <span>Explore Learning Paths</span>
          </Button>
        </div>
      </div>

      <!-- Live Interactive Architecture Flow Diagram in Hero -->
      <div class="mt-6">
        <SystemFlowSimulator client:load />
      </div>
    </div>
  </section>

  <!-- Section 3 — Interactive Engineering Knowledge Map -->
  <section class="border-b border-border-subtle py-16 sm:py-24 px-4 sm:px-6 bg-surface">
    <div class="max-w-layout mx-auto">
      <div class="max-w-3xl mb-10">
        <div class="font-mono text-xs text-brand font-semibold uppercase tracking-wider mb-2">
          KNOWLEDGE GRAPH
        </div>
        <h2 class="font-editorial text-3xl sm:text-5xl font-bold text-text-primary mb-4">
          Interactive Architecture Map
        </h2>
        <p class="font-technical text-base text-text-secondary leading-relaxed">
          Trace how fundamental networking primitives connect to operating system syscalls, distributed caches, and large-scale message brokers. Select any concept to explore its prerequisites and downstream dependencies.
        </p>
      </div>

      <!-- Interactive Knowledge Map Component -->
      <InteractiveKnowledgeMap client:visible />
    </div>
  </section>

  <!-- Section 4 — Learning Paths Progression -->
  <section class="border-b border-border-subtle py-16 sm:py-24 px-4 sm:px-6 bg-surface/40">
    <div class="max-w-layout mx-auto">
      <div class="max-w-3xl mb-12">
        <div class="font-mono text-xs text-brand font-semibold uppercase tracking-wider mb-2">
          PROGRESSIVE CURRICULUM
        </div>
        <h2 class="font-editorial text-3xl sm:text-5xl font-bold text-text-primary mb-4">
          Sequential Learning Paths
        </h2>
        <p class="font-technical text-base text-text-secondary leading-relaxed">
          Systems engineering cannot be mastered through disconnected summaries. Every phase builds upon the physical invariants and operating system primitives mastered in the previous phase.
        </p>
      </div>

      <!-- Interactive Curriculum Dependency Flow Graph -->
      <CurriculumFlowGraph client:visible />
    </div>
  </section>

  <!-- Section 5 — Featured Engineering Topics -->
  <section class="border-b border-border-subtle py-16 sm:py-24 px-4 sm:px-6 max-w-layout mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
      <div>
        <div class="font-mono text-xs text-brand font-semibold uppercase tracking-wider mb-2">
          CONCEPTS & INVARIANTS
        </div>
        <h2 class="font-editorial text-3xl sm:text-4xl font-bold text-text-primary">
          Featured Engineering Topics
        </h2>
      </div>

      <a
        href={formatPath('/explore')}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand hover:underline font-technical"
      >
        <span>View all {TOPICS.length} topics in directory</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredTopics.map((topic) => (
        <a
          href={formatPath('/explore')}
          class="group rounded-lg border border-border-subtle bg-surface p-6 hover:border-brand/40 hover:bg-surface-elevated/40 transition-all flex flex-col justify-between glow-card"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[11px] text-text-muted">
                {topic.domain}
              </span>
              <Badge variant={topic.difficulty === 'Intermediate' ? 'warning' : 'danger'} size="sm">
                {topic.difficulty.toUpperCase()}
              </Badge>
            </div>

            <h3 class="font-editorial text-xl font-bold text-text-primary group-hover:text-brand transition-colors">
              {topic.title}
            </h3>

            <p class="text-xs text-text-secondary font-technical leading-relaxed">
              {topic.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-border-subtle flex items-center justify-between text-[11px] font-mono text-text-muted">
            <span>Requires: {topic.prereq}</span>
            <span class="text-brand font-semibold group-hover:translate-x-1 transition-transform">
              Inspect &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Section 6 — Dynamic Request Workflow Simulation Showcase -->
  <section class="border-b border-border-subtle py-16 sm:py-24 px-4 sm:px-6 bg-surface/50">
    <div class="max-w-layout mx-auto">
      <div class="max-w-3xl mb-10">
        <div class="font-mono text-xs text-brand font-semibold uppercase tracking-wider mb-2">
          PACKET LIFECYCLE
        </div>
        <h2 class="font-editorial text-3xl sm:text-5xl font-bold text-text-primary mb-4">
          How a Request Moves Across the Wire
        </h2>
        <p class="font-technical text-base text-text-secondary leading-relaxed">
          Step through an HTTP request lifecycle from DNS query and TCP/TLS handshakes to kernel socket buffer allocation, reverse proxying, and cache-aside storage.
        </p>
      </div>

      <!-- Interactive Workflow Diagram -->
      <WorkflowDiagram client:visible />
    </div>
  </section>

  <!-- Section 7 — Latest Articles & Deep Dives -->
  <section class="border-b border-border-subtle py-16 sm:py-24 px-4 sm:px-6 max-w-layout mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
      <div>
        <div class="font-mono text-xs text-brand font-semibold uppercase tracking-wider mb-2">
          TECHNICAL GUIDES
        </div>
        <h2 class="font-editorial text-3xl sm:text-4xl font-bold text-text-primary">
          First-Principles Architecture Guides
        </h2>
      </div>

      <a
        href={formatPath('/articles')}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand hover:underline font-technical"
      >
        <span>View all 10 guides in index</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredArticles.map((art) => (
        <a
          href={art.url}
          class="group rounded-lg border border-border-subtle bg-surface p-6 hover:border-brand/40 hover:bg-surface-elevated/40 transition-all flex flex-col justify-between glow-card"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-brand px-2 py-0.5 rounded bg-brand-subtle border border-brand/20">
                {art.number}
              </span>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-surface-elevated border border-border-subtle text-text-secondary">
                {art.interactiveType}
              </span>
            </div>

            <h3 class="font-editorial text-lg font-bold text-text-primary group-hover:text-brand transition-colors">
              {art.title}
            </h3>

            <p class="text-xs text-text-secondary font-technical leading-relaxed">
              {art.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-border-subtle flex items-center justify-between text-xs font-mono text-text-muted">
            <div class="flex items-center gap-1.5">
              <Clock class="w-3.5 h-3.5" />
              <span>{art.readingTime}</span>
            </div>
            <span class="inline-flex items-center gap-1 text-brand font-semibold group-hover:translate-x-1 transition-transform">
              Read Guide <ArrowRight class="w-3.5 h-3.5" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Section 8 — Engineering Case Studies -->
  <section class="border-b border-border-subtle py-16 sm:py-24 px-4 sm:px-6 max-w-layout mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
      <div>
        <div class="font-mono text-xs text-brand font-semibold uppercase tracking-wider mb-2">
          SYSTEM BLUEPRINTS
        </div>
        <h2 class="font-editorial text-3xl sm:text-4xl font-bold text-text-primary">
          Production Architecture Case Studies
        </h2>
      </div>

      <a
        href={formatPath('/system-design')}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand hover:underline font-technical"
      >
        <span>Explore all system design blueprints</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {caseStudiesPreview.map((study) => (
        <a
          href={formatPath('/system-design')}
          class="group rounded-lg border border-border-subtle bg-surface p-6 hover:border-brand/40 hover:bg-surface-elevated/40 transition-all flex flex-col justify-between glow-card"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <Badge variant={study.difficulty === 'Intermediate' ? 'warning' : 'danger'} size="sm">
                {study.difficulty.toUpperCase()}
              </Badge>
              <span class="font-mono text-[10px] text-text-muted">
                {study.scale}
              </span>
            </div>

            <h3 class="font-editorial text-xl font-bold text-text-primary group-hover:text-brand transition-colors">
              {study.title}
            </h3>

            <p class="text-xs text-text-secondary font-technical leading-relaxed">
              {study.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-border-subtle flex items-center justify-between text-xs font-mono text-brand font-semibold">
            <span>Inspect Blueprint</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Section 8 — Custom Diagram Studio Introduction -->
  <section class="border-b border-border-subtle py-16 sm:py-24 px-4 sm:px-6 bg-surface/40">
    <div class="max-w-layout mx-auto">
      <div class="rounded-xl border border-border-subtle bg-surface p-8 sm:p-12 glow-card relative overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div class="space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-subtle border border-brand/20 text-brand text-xs font-mono">
              <Sparkles class="w-3.5 h-3.5" />
              <span>CUSTOM ARCHITECTURE WORKSPACE</span>
            </div>

            <h2 class="font-editorial text-3xl sm:text-5xl font-bold text-text-primary tracking-tight leading-[1.15]">
              Diagram Studio: Design Systems Directly in Your Browser.
            </h2>

            <p class="font-technical text-base text-text-secondary leading-relaxed max-w-xl">
              An approachable, vector drawing workspace inspired by Excalidraw—tailored specifically for backend engineers and distributed architects. Connect microservices, trace request lifecycles, and export publication-ready diagrams with zero login required.
            </p>

            <div class="grid grid-cols-2 gap-3 text-xs font-technical text-text-secondary">
              <div class="flex items-center gap-2">
                <span class="text-brand font-bold">•</span>
                <span>Specialized System Shapes</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-brand font-bold">•</span>
                <span>Export to PNG, SVG & JSON</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-brand font-bold">•</span>
                <span>8 Production Blueprints</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-brand font-bold">•</span>
                <span>Offline Draft Persistence</span>
              </div>
            </div>

            <div class="pt-2 flex flex-wrap items-center gap-4">
              <Button href={formatPath('/studio')} variant="primary" size="lg">
                <span>Launch Diagram Studio</span>
                <ArrowRight class="w-4 h-4" />
              </Button>
              <a
                href={formatPath('/studio')}
                class="font-mono text-xs font-semibold text-text-secondary hover:text-text-primary transition-colors underline underline-offset-4"
              >
                Browse 8 Starter Templates &rarr;
              </a>
            </div>
          </div>

          <!-- Interactive Workspace Mockup Preview -->
          <div class="rounded-lg border border-border-subtle bg-canvas p-4 shadow-lg space-y-3 font-mono text-xs">
            <div class="flex items-center justify-between pb-2 border-b border-border-subtle text-[11px] text-text-muted">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="font-bold text-text-primary pl-2">three-tier-cluster.complexity.json</span>
              </div>
              <span className="text-[10px] bg-surface-elevated px-2 py-0.5 rounded border border-border-subtle">
                Canvas 100%
              </span>
            </div>

            <div class="grid grid-cols-3 gap-3 py-6 px-2 text-center text-xs">
              <div class="p-3 rounded-lg border border-sky-500/30 bg-sky-500/10 text-sky-600 dark:text-sky-400 font-bold">
                Client (HTTPS)
              </div>
              <div class="p-3 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">
                API Gateway
              </div>
              <div class="p-3 rounded-lg border border-indigo-500/30 bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold">
                App Service
              </div>
              <div class="col-span-2 p-3 rounded-lg border border-orange-500/30 bg-orange-500/10 text-orange-600 dark:text-orange-400 font-bold">
                Redis Cache (Sub-ms Latency)
              </div>
              <div class="p-3 rounded-lg border border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold">
                PostgreSQL DB
              </div>
            </div>

            <div class="pt-2 border-t border-border-subtle/80 flex items-center justify-between text-[11px] text-text-muted">
              <span>Tools: [Select] [Pan] [Rectangle] [Arrow] [Systems]</span>
              <span className="text-brand font-semibold">Ready to Draw</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Seven Fundamental Questions Manifesto -->
  <section class="py-16 sm:py-20 px-4 sm:px-6 bg-surface">
    <div class="max-w-layout mx-auto">
      <div class="max-w-2xl mb-12">
        <div class="font-mono text-xs text-brand font-semibold uppercase tracking-wider mb-2">
          PEDAGOGICAL INVARIANT
        </div>
        <h2 class="font-editorial text-3xl sm:text-4xl font-bold text-text-primary mb-4">
          The 7 Questions Behind Every System
        </h2>
        <p class="font-technical text-sm text-text-secondary leading-relaxed">
          Every article, simulation, and case study on Complexity deconstructs engineering choices against these immutable production constraints.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { q: "01. Why does it exist?", d: "What historic wall or bottleneck led to its creation?" },
          { q: "02. What problem does it solve?", d: "Exactly what pain point does it address?" },
          { q: "03. How does it work internally?", d: "Data structures, sockets, and concurrency models." },
          { q: "04. What happens under traffic?", d: "Connection pooling, queue depth, and thread pools." },
          { q: "05. What happens when it fails?", d: "Cascading timeouts and network partitions." },
          { q: "06. What alternatives exist?", d: "Trade-offs and architectural comparison matrices." },
          { q: "07. Why choose it in production?", d: "Operational complexity and maintenance overhead." },
          { q: "08. First-Principles Verified", d: "Zero fake benchmarks or fabricated statistics." }
        ].map((item) => (
          <div class="p-4 rounded-lg border border-border-subtle bg-surface-elevated/40">
            <h3 class="font-technical text-xs font-bold text-text-primary mb-1">
              {item.q}
            </h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              {item.d}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
