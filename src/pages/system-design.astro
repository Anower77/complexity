---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import { formatPath } from '@/lib/utilities/url';
import { ArrowRight, Cpu, Database, Network, ShieldCheck, Zap, Layers, Sparkles, Server, Terminal, Radio } from 'lucide-react';

const breadcrumbs = [
  { label: 'System Design' }
];

const caseStudies = [
  {
    id: 'case-url-shortener',
    title: 'High-Throughput URL Shortener',
    difficulty: 'Intermediate',
    qps: '100,000 QPS (Read Heavy 100:1)',
    storage: '15 TB / 5 Years (1 Billion URLs)',
    summary: 'Deconstructs Base62 token encoding, distributed counter ranges, cache-aside Redis clusters, and B-Tree indexing guarantees.',
    architecture: [
      'Clients submit long URLs via API Gateway with sliding-window rate limiters.',
      'Distributed Ticket Server or Snowflake worker generates sequential 64-bit ID.',
      'Worker encodes ID into 7-character Base62 string (a-z, A-Z, 0-9 = 3.5 trillion unique keys).',
      'Row persisted in PostgreSQL with UNIQUE index on short_code.',
      'Redis cluster caches hot URLs with LRU eviction and 7-day TTL.',
      'HTTP 301 Permanent vs 302 Temporary redirect trade-offs.'
    ],
    bottlenecks: 'Database read replication lag, cache stampedes on viral URLs, and token collision mitigation.'
  },
  {
    id: 'case-chat-system',
    title: 'Real-Time Chat & Direct Messaging',
    difficulty: 'Advanced',
    qps: '500,000 Concurrent Sockets / 50k Msg/sec',
    storage: '100 TB / Year (Wide-Column Cassandra)',
    summary: 'Persistent stateful WebSocket gateways, Redis Pub/Sub multiplexers, presence heartbeats, and append-only message stores.',
    architecture: [
      'Clients maintain persistent bidirectional WebSocket connections to Gateway nodes.',
      'Connection Manager service maintains ephemeral socket-to-user mappings in Redis.',
      'Messages dispatched to Redis Pub/Sub or Kafka topics partitioned by channel_id.',
      'Worker pools asynchronously archive messages to Apache Cassandra clustered by (channel_id, message_id).',
      'Offline notifications routed to APNs/FCM via background worker queues.',
      'Heartbeat probes detect dropped sockets within 15 seconds.'
    ],
    bottlenecks: 'Stateful gateway failover, thundering herd reconnects on server crash, and large-group message fan-out.'
  },
  {
    id: 'case-video-streaming',
    title: 'Adaptive Bitrate Video Streaming',
    difficulty: 'Advanced',
    qps: '2,000,000 Concurrent Video Streams',
    storage: 'Petabyte Object Storage + Global CDN',
    summary: 'Chunked HLS/DASH media segmenting, distributed transcoding DAGs, multi-tier edge CDN caching, and origin shield protection.',
    architecture: [
      'Raw video uploaded via chunked multipart upload directly to Object Storage (S3).',
      'Message queue triggers distributed transcoding cluster creating multi-bitrate HLS streams (1080p, 720p, 480p, 360p).',
      'Videos sliced into 4-second `.ts` or `.m4s` chunks with `.m3u8` master manifest.',
      'Global Anycast CDN caches chunks at edge nodes closest to viewers.',
      'Origin Shield protects storage bucket from cold cache misses.',
      'Client media player dynamically switches bitrates based on local network throughput.'
    ],
    bottlenecks: 'Massive egress bandwidth costs, transcoding queue backlog during peak uploads, and edge cache purges.'
  },
  {
    id: 'case-notification-engine',
    title: 'Distributed Notification System',
    difficulty: 'Intermediate',
    qps: '20,000 Notifications / Second',
    storage: 'Multi-Region Queue + PostgreSQL',
    summary: 'Priority queues, per-user rate limiters, template rendering engines, and third-party vendor fallbacks (Twilio, Sendgrid, APNs).',
    architecture: [
      'Application services emit notification events with priority tags (Critical, Standard, Marketing).',
      'RabbitMQ or SQS priority queues buffer events according to delivery urgency.',
      'Deduplication worker verifies idempotency key in Redis to prevent duplicate sends.',
      'User preference engine filters out opted-out channels and enforces quiet hours.',
      'Vendor dispatch workers send payload via Twilio, SendGrid, or APNs with circuit-breaker fallbacks.',
      'Dead-letter queues capture failed delivery attempts for automatic retry with exponential jitter.'
    ],
    bottlenecks: 'Third-party API rate limits, out-of-order message arrival, and retry storms when vendor gateways degrade.'
  }
];

const principles = [
  {
    title: 'CAP Theorem & PACELC',
    desc: 'Under network partitions, distributed systems must trade off between immediate strong consistency (CP) or continuous availability (AP). In the absence of partitions (PC), systems trade latency (L) against consistency (C).'
  },
  {
    title: 'Stateless Application Tiers',
    desc: 'Never store user sessions in local server memory. Offload state to external datastores so any node can be terminated or autoscaled without impacting active client transactions.'
  },
  {
    title: 'Cache-Aside & Thundering Herds',
    desc: 'Applications query the cache first; on a miss, they query the database and backfill the cache. Mutex locks or probabilistic early expiration prevent thousands of concurrent misses from crushing the database.'
  },
  {
    title: 'Database Sharding & Consistent Hashing',
    desc: 'Distribute table rows across multiple database servers using hash partitions. Consistent hashing rings minimize data rebalancing when servers are added or removed.'
  }
];
---

<BaseLayout
  title="System Design Blueprints — Complexity"
  description="Production system design case studies: URL shortener, real-time chat, video streaming, and distributed notifications from first principles."
>
  <div class="max-w-layout mx-auto px-4 sm:px-6 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Editorial Header -->
    <header class="mb-12 pb-8 border-b border-border-subtle">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-surface-elevated border border-border-subtle font-mono text-[11px] text-text-muted mb-4">
        <Cpu className="w-3.5 h-3.5 text-brand" />
        <span>SYSTEM ARCHITECTURE BLUEPRINTS</span>
      </div>

      <h1 class="font-editorial text-4xl sm:text-5xl font-bold text-text-primary tracking-tight mb-4">
        System Design & Case Studies
      </h1>

      <p class="text-base sm:text-lg text-text-secondary max-w-3xl font-technical leading-relaxed">
        Production architecture blueprints without fabricated claims or vendor hype. We examine back-of-the-envelope calculations, data flows, storage bounds, and real-world failure bottlenecks.
      </p>
    </header>

    <!-- Fundamental Architectural Principles -->
    <section class="mb-16">
      <div class="mb-6">
        <span class="font-mono text-xs font-bold text-brand uppercase tracking-wider block mb-1">
          FOUNDATIONS
        </span>
        <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-text-primary">
          Core System Design Invariants
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {principles.map((item) => (
          <div class="p-5 rounded-lg border border-border-subtle bg-surface hover:border-brand/30 transition-all glow-card">
            <h3 class="font-editorial text-base font-bold text-text-primary mb-2">
              {item.title}
            </h3>
            <p class="text-xs text-text-secondary font-technical leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Detailed Case Studies -->
    <section class="space-y-12">
      <div class="pb-4 border-b border-border-subtle">
        <span class="font-mono text-xs font-bold text-brand uppercase tracking-wider block mb-1">
          DEEP DIVES
        </span>
        <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-text-primary">
          End-to-End Architectural Case Studies
        </h2>
        <p class="text-xs sm:text-sm text-text-secondary font-technical mt-1">
          Step through requirements, high-level diagrams, and edge-case failure modes for real production architectures.
        </p>
      </div>

      <div class="space-y-8">
        {caseStudies.map((study, idx) => (
          <div class="rounded-xl border border-border-strong bg-surface p-6 sm:p-8 glow-card space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-border-subtle">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-brand-subtle text-brand border border-brand/20">
                    CASE 0{idx + 1}
                  </span>
                  <Badge variant={study.difficulty === 'Intermediate' ? 'warning' : 'danger'} size="sm">
                    {study.difficulty.toUpperCase()}
                  </Badge>
                </div>
                <h3 class="font-editorial text-2xl sm:text-3xl font-bold text-text-primary">
                  {study.title}
                </h3>
              </div>

              <div class="text-right font-mono text-xs text-text-muted space-y-0.5">
                <div>Scale: <span class="text-text-primary font-semibold">{study.qps}</span></div>
                <div>Storage: <span class="text-text-primary font-semibold">{study.storage}</span></div>
              </div>
            </div>

            <p class="text-sm text-text-secondary font-technical leading-relaxed">
              {study.summary}
            </p>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-2">
              <!-- Architecture Steps -->
              <div class="space-y-2">
                <h4 class="font-technical text-xs font-bold text-text-primary uppercase tracking-wider mb-2 flex items-center gap-1.5">
                  <Layers className="w-3.5 h-3.5 text-brand" />
                  <span>Architecture & Data Flow</span>
                </h4>
                <ol class="space-y-2 text-xs text-text-secondary font-technical">
                  {study.architecture.map((step, sIdx) => (
                    <li class="flex items-start gap-2 p-2 rounded bg-surface-elevated/60 border border-border-subtle">
                      <span class="font-mono text-brand font-bold">{sIdx + 1}.</span>
                      <span class="leading-relaxed">{step}</span>
                    </li>
                  ))}
                </ol>
              </div>

              <!-- Failure Modes & Bottlenecks -->
              <div class="space-y-3">
                <h4 class="font-technical text-xs font-bold text-text-primary uppercase tracking-wider mb-2 flex items-center gap-1.5 text-amber-500">
                  <ShieldCheck className="w-3.5 h-3.5" />
                  <span>Production Bottlenecks & Failure Modes</span>
                </h4>
                <div class="p-4 rounded-lg bg-surface-elevated/60 border border-border-subtle text-xs text-text-secondary leading-relaxed font-technical">
                  {study.bottlenecks}
                </div>

                <div class="p-4 rounded-lg bg-brand-subtle/50 border border-brand-border/40 text-xs text-text-secondary leading-relaxed font-technical">
                  <div class="font-mono text-[11px] font-bold text-brand uppercase mb-1">
                    First-Principles Trade-off:
                  </div>
                  Systems at this scale deliberately sacrifice strict relational ACID guarantees in favor of asynchronous worker queues and eventually consistent cache reads.
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom Navigation Callout -->
    <div class="mt-16 p-6 sm:p-8 rounded-lg border border-border-subtle bg-surface-elevated/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="space-y-1">
        <h3 class="font-editorial text-xl font-bold text-text-primary">
          Want to explore the foundational socket mechanics first?
        </h3>
        <p class="text-xs sm:text-sm text-text-secondary font-technical">
          Step through our Structured Path from physical transport layers to global distributed systems.
        </p>
      </div>

      <a
        href={formatPath('/path')}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-brand text-white font-mono text-xs font-semibold hover:bg-brand-hover transition-colors whitespace-nowrap shadow-sm"
      >
        <span>Explore Structured Path</span>
        <ArrowRight className="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</BaseLayout>
