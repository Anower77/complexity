---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CurriculumFlowGraph from '@/components/visualization/CurriculumFlowGraph';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import { formatPath } from '@/lib/utilities/url';
import { ArrowRight, Layers, CheckCircle2 } from 'lucide-react';

const breadcrumbs = [
  { label: 'Learning Paths' }
];

const paths = [
  {
    title: 'Phase 1: Engineering Foundations',
    description: 'Master how the internet works, operating system processes, threads, sockets, DNS resolution, and TCP/UDP transport lifecycles.',
    courseCount: 1,
    lessonCount: 3,
    difficulty: 'beginner',
    slug: 'system-architecture-fundamentals',
    topics: ['Client-Server Topology', 'Transport Protocols (TCP vs UDP)', 'DNS Resolution & Sockets', 'Stateless Architecture']
  },
  {
    title: 'Phase 2: Infrastructure & Containers',
    description: 'Learn virtual machines, container runtimes (Docker/runc), reverse proxies (Nginx), in-memory caching (Redis), and connection pooling.',
    courseCount: 1,
    lessonCount: 0,
    difficulty: 'intermediate',
    status: 'coming-soon',
    topics: ['Docker Internals & OverlayFS', 'Nginx Reverse Proxying', 'Redis Caching & Eviction Policies', 'PostgreSQL MVCC']
  },
  {
    title: 'Phase 3: Distributed Systems',
    description: 'Understand asynchronous message brokers (RabbitMQ/Kafka), replication models, database sharding, and consensus algorithms.',
    courseCount: 1,
    lessonCount: 0,
    difficulty: 'advanced',
    status: 'coming-soon',
    topics: ['Commit Logs & Consumer Groups', 'Two-Phase Commits', 'Raft Consensus', 'Partitioning Strategies']
  }
];
---

<BaseLayout
  title="Learning Paths — Complexity"
  description="Structured 6-phase engineering curriculum from hardware and networking to global distributed architecture."
>
  <div class="max-w-layout mx-auto px-4 sm:px-6 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-10 pb-6 border-b border-border-subtle">
      <div class="font-mono text-xs text-brand font-semibold uppercase tracking-wider mb-2">
        CURRICULUM ROADMAP
      </div>
      <h1 class="font-editorial text-3xl sm:text-5xl font-bold text-text-primary tracking-tight mb-3">
        Structured Learning Paths
      </h1>
      <p class="text-base text-text-secondary max-w-2xl font-technical">
        Follow a step-by-step engineering progression designed to take developers from understanding fundamental sockets up to designing large-scale distributed systems.
      </p>
    </header>

    <!-- Interactive Visual Learning Path Flow Graph -->
    <div class="mb-16">
      <CurriculumFlowGraph client:load />
    </div>

    <div class="mb-8">
      <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-text-primary mb-2">
        Detailed Phase Breakdown
      </h2>
      <p class="text-xs text-text-muted font-technical">
        Explore what each engineering phase teaches and how they connect.
      </p>
    </div>

    <div class="space-y-6">
      {paths.map((path, idx) => (
        <div class="rounded-lg border border-border-subtle bg-surface p-6 sm:p-8 hover:border-border-strong transition-all glow-card">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-surface-elevated border border-border-subtle text-text-primary">
                PHASE 0{idx + 1}
              </span>
              <Badge variant={path.difficulty === 'beginner' ? 'success' : 'warning'} size="sm">
                {path.difficulty.toUpperCase()}
              </Badge>
            </div>
            {path.status === 'coming-soon' ? (
              <span class="font-mono text-[11px] text-amber-500 bg-amber-500/10 px-2.5 py-0.5 rounded border border-amber-500/20 w-fit">
                COMING SOON
              </span>
            ) : (
              <span class="font-mono text-[11px] text-green-500 bg-green-500/10 px-2.5 py-0.5 rounded border border-green-500/20 w-fit">
                READY TO LEARN
              </span>
            )}
          </div>

          <h3 class="font-editorial text-xl sm:text-2xl font-bold text-text-primary mb-2">
            {path.title}
          </h3>

          <p class="text-sm text-text-secondary leading-relaxed mb-6 font-technical max-w-3xl">
            {path.description}
          </p>

          <div class="mb-6">
            <div class="font-mono text-[11px] uppercase tracking-wider text-text-muted mb-2">
              Key Topics Covered
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {path.topics.map((t) => (
                <div class="flex items-center gap-2 text-xs text-text-secondary font-technical">
                  <span class="text-brand font-bold">•</span>
                  <span>{t}</span>
                </div>
              ))}
            </div>
          </div>

          {path.slug && (
            <div class="pt-4 border-t border-border-subtle">
              <a
                href={formatPath(`/courses/${path.slug}`)}
                class="inline-flex items-center gap-2 text-xs font-semibold text-brand hover:underline font-technical"
              >
                <span>Start Phase Course</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
