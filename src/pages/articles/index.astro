---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import { formatPath } from '@/lib/utilities/url';
import { ArrowRight, BookOpen, Clock, Sparkles, Filter, Terminal, Cpu, Network, Database, ShieldAlert } from 'lucide-react';

const breadcrumbs = [
  { label: 'Articles & Guides' }
];

const articles = [
  {
    number: '01.01',
    title: 'Introduction to Client-Server Architecture',
    description: 'Deconstructing the fundamental communication paradigm that powers the modern internet. Socket allocations, connection states, and request lifecycles.',
    topic: 'Networking & Protocols',
    topicId: 'networking',
    readingTime: '7 min',
    interactiveType: 'Interactive Simulator',
    status: 'published',
    url: formatPath('/articles/client-server-architecture')
  },
  {
    number: '01.02',
    title: 'Request Lifecycle & Transport Protocols',
    description: 'Tracing a network packet from socket allocation down through TCP handshake, TLS negotiation, and HTTP/2 application multiplexing.',
    topic: 'Networking & Protocols',
    topicId: 'networking',
    readingTime: '9 min',
    interactiveType: 'Live Workflow Diagram',
    status: 'published',
    url: formatPath('/articles/request-lifecycle-and-protocols')
  },
  {
    number: '01.03',
    title: 'DNS: How Domain Names Find Servers',
    description: 'Hierarchical tree resolution, recursive resolvers, root name servers, anycast routing, and TTL caching failure modes.',
    topic: 'Networking & Protocols',
    topicId: 'networking',
    readingTime: '8 min',
    interactiveType: 'Interactive Diagram',
    status: 'published',
    url: formatPath('/articles/dns-resolution-and-sockets')
  },
  {
    number: '02.04',
    title: 'Kubernetes Services Explained: ClusterIP vs NodePort vs LoadBalancer',
    description: 'Three ways to expose your Kubernetes Pods. Understand how traffic reaches your applications, where each Service type is used, and how Kubernetes routes requests.',
    topic: 'Linux & Runtime',
    topicId: 'runtime',
    readingTime: '14 min',
    interactiveType: 'Interactive Simulator & Stepper',
    status: 'published',
    url: formatPath('/articles/kubernetes-services-clusterip-nodeport-loadbalancer')
  },
  {
    number: '02.01',
    title: 'Inside a Linux Server: Epoll & File Descriptors',
    description: 'Why select() and poll() scale with O(N) complexity and how the Linux kernel solved the C10K concurrency bottleneck with epoll event readiness.',
    topic: 'Linux & Runtime',
    topicId: 'runtime',
    readingTime: '12 min',
    interactiveType: 'Kernel Deep Dive',
    status: 'planned'
  },
  {
    number: '02.02',
    title: 'Docker Internals: Namespaces, Cgroups & OverlayFS',
    description: 'How container engines create the illusion of isolated operating systems using Linux PID/mount namespaces, control groups, and layered file systems.',
    topic: 'Linux & Runtime',
    topicId: 'runtime',
    readingTime: '14 min',
    interactiveType: 'Runtime Architecture',
    status: 'planned'
  },
  {
    number: '02.03',
    title: 'Redis: In-Memory Caching & Eviction Policies',
    description: 'Single-threaded event loop, RESP protocol, LRU/LFU memory eviction algorithms, and thundering herd mitigation under extreme traffic surges.',
    topic: 'Linux & Runtime',
    topicId: 'runtime',
    readingTime: '15 min',
    interactiveType: 'Simulate Failure Mode',
    status: 'planned'
  },
  {
    number: '03.01',
    title: 'Asynchronous Queues & Dead Letter Exchanges',
    description: 'Decoupling peak ingestion spikes from database writes using message brokers, consumer acknowledgments, idempotency keys, and retry dead-lettering.',
    topic: 'Distributed Systems',
    topicId: 'distributed',
    readingTime: '12 min',
    interactiveType: 'Workflow Simulator',
    status: 'planned'
  },
  {
    number: '03.02',
    title: 'Kafka: Distributed Commit Logs & Partitioning',
    description: 'Zero-copy sequential disk I/O, page cache exploitation, consumer group rebalancing, and partition leader election under network partitions.',
    topic: 'Distributed Systems',
    topicId: 'distributed',
    readingTime: '16 min',
    interactiveType: 'Distributed Storage',
    status: 'planned'
  },
  {
    number: '04.01',
    title: 'Rate Limiting: Token Bucket vs Sliding Window',
    description: 'Mathematical comparison of token bucket, leaky bucket, and sliding window log algorithms for high-throughput API gateway protection.',
    topic: 'Production & Reliability',
    topicId: 'reliability',
    readingTime: '10 min',
    interactiveType: 'Live Algorithm Simulator',
    status: 'planned'
  },
  {
    number: '04.02',
    title: 'Circuit Breakers & Cascading Outages',
    description: 'Preventing catastrophic retry storms when downstream microservices degrade, with automated three-state failure detection and half-open probe recovery.',
    topic: 'Production & Reliability',
    topicId: 'reliability',
    readingTime: '11 min',
    interactiveType: 'Failure Cascade Model',
    status: 'planned'
  }
];

const topics = [
  { id: 'all', label: 'All Articles' },
  { id: 'networking', label: 'Networking & Protocols' },
  { id: 'runtime', label: 'Linux & Runtime' },
  { id: 'distributed', label: 'Distributed Systems' },
  { id: 'reliability', label: 'Production & Reliability' }
];
---

<BaseLayout
  title="Articles & Guides — Complexity"
  description="Backend system design from first principles. Deep dives into sockets, operating systems, distributed storage, and production reliability."
>
  <div class="max-w-layout mx-auto px-4 sm:px-6 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Editorial Header -->
    <header class="mb-12 pb-8 border-b border-border-subtle relative">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-surface-elevated border border-border-subtle font-mono text-[11px] text-text-muted mb-4">
        <Sparkles className="w-3.5 h-3.5 text-brand" />
        <span>First-Principles System Architecture</span>
      </div>

      <h1 class="font-editorial text-3xl sm:text-5xl font-bold text-text-primary tracking-tight mb-4">
        Articles & Technical Guides
      </h1>
      <p class="text-base sm:text-lg text-text-secondary max-w-3xl font-technical leading-relaxed">
        Cohesive, deeply researched architectural guides without paywalls, corporate hype, or course upsells. Every guide answers how the system operates under load, how it fails, and why engineers chose its trade-offs.
      </p>

      <div class="flex flex-wrap items-center gap-6 mt-6 pt-6 border-t border-border-subtle/60 text-xs font-mono text-text-muted">
        <div>
          <span class="text-text-primary font-bold">11</span> Guides Indexed
        </div>
        <span class="text-border-subtle">•</span>
        <div>
          <span class="text-emerald-500 font-bold">4</span> Ready to Read
        </div>
        <span class="text-border-subtle">•</span>
        <div>
          <span class="text-brand font-bold">100%</span> Free & Open Access
        </div>
      </div>
    </header>

    <!-- Articles List -->
    <div class="space-y-4">
      {articles.map((art) => {
        const isPublished = art.status === 'published';
        return (
          <div
            class={`group relative rounded-lg border transition-all ${
              isPublished
                ? 'border-border-subtle bg-surface hover:border-brand/40 hover:bg-surface-elevated/40'
                : 'border-border-subtle/50 bg-surface/40 opacity-75 hover:opacity-100 hover:border-border-subtle'
            }`}
          >
            <div class="p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-2 flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="font-mono text-xs font-bold text-brand px-2 py-0.5 rounded bg-brand-subtle border border-brand/20">
                    {art.number}
                  </span>
                  <span class="font-mono text-[11px] text-text-muted">
                    {art.topic}
                  </span>
                  <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-surface-elevated border border-border-subtle text-text-secondary">
                    {art.interactiveType}
                  </span>
                </div>

                <h2 class="font-editorial text-lg sm:text-xl font-bold text-text-primary group-hover:text-brand transition-colors">
                  {isPublished ? (
                    <a href={art.url} class="focus:outline-none">
                      {art.title}
                    </a>
                  ) : (
                    <span>{art.title}</span>
                  )}
                </h2>

                <p class="text-xs sm:text-sm text-text-secondary font-technical leading-relaxed max-w-3xl">
                  {art.description}
                </p>
              </div>

              <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-3 pt-3 sm:pt-0 border-t sm:border-t-0 border-border-subtle/50 flex-shrink-0">
                <div class="flex items-center gap-2 text-xs font-mono text-text-muted">
                  <Clock className="w-3.5 h-3.5" />
                  <span>{art.readingTime}</span>
                </div>

                {isPublished ? (
                  <a
                    href={art.url}
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-brand text-white font-mono text-xs font-semibold hover:bg-brand-hover shadow-sm transition-all"
                  >
                    <span>Read Guide</span>
                    <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
                  </a>
                ) : (
                  <span class="font-mono text-[10px] text-text-muted bg-surface-elevated px-2.5 py-1 rounded border border-border-subtle">
                    Phase In Development
                  </span>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Bottom Link to Structured Path -->
    <div class="mt-14 p-6 sm:p-8 rounded-lg border border-border-subtle bg-surface-elevated/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="space-y-1">
        <h3 class="font-editorial text-lg sm:text-xl font-bold text-text-primary">
          Looking for a sequential learning progression?
        </h3>
        <p class="text-xs sm:text-sm text-text-secondary font-technical">
          Explore our Structured Path with dependency graphs, interactive flow simulators, and ordered modules.
        </p>
      </div>

      <a
        href={formatPath('/path')}
        class="inline-flex items-center gap-2 px-4 py-2 rounded bg-surface-elevated border border-border-strong text-text-primary hover:border-brand font-mono text-xs font-semibold transition-all whitespace-nowrap"
      >
        <span>View Structured Path</span>
        <ArrowRight className="w-3.5 h-3.5 text-brand" />
      </a>
    </div>
  </div>
</BaseLayout>
